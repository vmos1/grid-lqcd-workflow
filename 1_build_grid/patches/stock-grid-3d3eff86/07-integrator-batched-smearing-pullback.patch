+  //////////////////////////////////////////////////////////////////////////////////////////
+  static bool batch_smear_gate(const char *name) {
+    const char *v = std::getenv(name);
+    if (v == nullptr || *v == '\0') return false;
+    const std::string s(v);
+    if (s == "1") return true;
+    if (s == "0") return false;
+    std::cerr << name << "=" << v << ": must be 0 or 1." << std::endl;
+    exit(EXIT_FAILURE);
+    return false;
+  }
+  static bool batch_smear_on(void) {
+    static const bool on = batch_smear_gate("HASEN_GRID_BATCH_SMEAR");
+    return on;
+  }
+  static bool batch_smear_check(void) {
+    static const bool chk = batch_smear_gate("HASEN_GRID_BATCH_SMEAR_CHECK");
+    return chk;
+  }
