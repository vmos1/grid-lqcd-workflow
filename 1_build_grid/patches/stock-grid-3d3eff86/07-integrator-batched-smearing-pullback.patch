+
+      Real force_abs   = std::sqrt(norm2(fsm)/U.Grid()->gSites());
+      Real impulse_abs = force_abs * ep * HMC_MOMENTUM_DENOMINATOR;
+      Real force_max   = std::sqrt(maxLocalNorm2(fsm));
+      Real impulse_max = force_max * ep * HMC_MOMENTUM_DENOMINATOR;
+
+      std::cout << GridLogIntegrator<< "["<<level<<"] batched smeared dt           : " << ep <<" ("<<n_smeared<<" smeared actions, one pullback)"<<std::endl;
+      std::cout << GridLogIntegrator<< "["<<level<<"] batched smeared force average: " << force_abs <<std::endl;
+      std::cout << GridLogIntegrator<< "["<<level<<"] batched smeared force max    : " << force_max <<std::endl;
+      std::cout << GridLogIntegrator<< "["<<level<<"] batched smeared Fdt average  : " << impulse_abs <<std::endl;
+      std::cout << GridLogIntegrator<< "["<<level<<"] batched smeared Fdt max      : " << impulse_max <<std::endl;
+
+      if (check) {
+        Field diff(U.Grid());
+        diff = fsm - *force_ref;
+        RealD n2d = norm2(diff);
+        RealD n2r = norm2(*force_ref);
+        RealD mxd = std::sqrt(maxLocalNorm2(diff));
+        RealD mxr = std::sqrt(maxLocalNorm2(*force_ref));
+        std::streamsize prec = std::cout.precision();
+        std::cout.precision(6);
+        std::cout << GridLogMessage << "["<<level<<"] HASEN_GRID_BATCH_SMEAR_CHECK"
