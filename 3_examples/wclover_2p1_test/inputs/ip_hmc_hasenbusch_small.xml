<?xml version="1.0"?>
<!--
  Hasenbusch correctness test — small lattice (8^3 x 16), cold start.
  Single GPU, single rank. Used to verify FORCES output and code sanity.

  MDsteps=20 (step size 0.05) for better acceptance from cold start.
  NoMetropolisUntil=5 to let gauge field settle before Metropolis kicks in.

  Run via:
    bin/wclover_hasenbusch_tune_no_eo --ParameterFile inputs/ip_hmc_hasenbusch_small.xml \
        --grid 8.8.8.16 --mpi 1.1.1.1
-->
<grid>
  <HMC>
    <StartTrajectory>0</StartTrajectory>
    <Trajectories>10</Trajectories>
    <MetropolisTest>true</MetropolisTest>
    <NoMetropolisUntil>5</NoMetropolisUntil>
    <StartingType>ColdStart</StartingType>
    <PerformRandomShift>false</PerformRandomShift>
    <MD>
      <name>MinimumNorm2</name>
      <MDsteps>20</MDsteps>
      <trajL>1.0</trajL>
    </MD>
  </HMC>
  <Checkpointer>
    <config_prefix>./ckpoint_lat</config_prefix>
    <rng_prefix>./ckpoint_rng</rng_prefix>
    <saveInterval>1000</saveInterval>
    <saveSmeared>false</saveSmeared>
    <smeared_prefix>./ckpoint_lat_smr</smeared_prefix>
    <format>IEEE64BIG</format>
  </Checkpointer>
  <RandomNumberGenerator>
    <serial_seeds>21 32 73 64 45</serial_seeds>
    <parallel_seeds>63 79 81 99 10</parallel_seeds>
  </RandomNumberGenerator>
  <Action>
    <gauge_beta>6.3</gauge_beta>
    <ApplySmearing>false</ApplySmearing>
    <Light>
      <mass>-0.2416</mass>
      <csw_r>1.0</csw_r>
      <csw_t>1.0</csw_t>
      <StoppingCondition>1e-8</StoppingCondition>
      <MDStoppingCondition>1e-4</MDStoppingCondition>
      <MaxCGIterations>30000</MaxCGIterations>
    </Light>
    <Hasenbusch>
      <m_H1>-0.021</m_H1>
      <m_H2>0.212</m_H2>
      <m_H3>0.459</m_H3>
      <m_H4>0.721</m_H4>
    </Hasenbusch>
    <Strange>
      <mass>-0.2050</mass>
      <csw_r>1.0</csw_r>
      <csw_t>1.0</csw_t>
      <StoppingCondition>1e-8</StoppingCondition>
      <MDStoppingCondition>1e-4</MDStoppingCondition>
      <MaxCGIterations>30000</MaxCGIterations>
    </Strange>
    <StrangeRHMC>
      <lo>0.005</lo>
      <hi>100.0</hi>
      <degree>14</degree>
      <MaxIter>10000</MaxIter>
      <tolerance>1e-8</tolerance>
      <mdtolerance>1e-6</mdtolerance>
      <precision>50</precision>
      <BoundsCheckFreq>20</BoundsCheckFreq>
    </StrangeRHMC>
  </Action>
  <StoutSmearing>
    <rho>0.1</rho>
    <Nsmear>3</Nsmear>
  </StoutSmearing>
</grid>
