        <elem>HMC::ratio</elem>
        <elem>HMC::tail</elem>
        <elem>HMC::lw_tree_gauge</elem>
      </monomial_ids>
    </Hamiltonian>
<MDIntegrator>
      <tau0>0.5</tau0>
      <copyList>
        <elem>
          <copyFrom>HMC::ratio</copyFrom>
          <copyTo>MD::ratio</copyTo>
        </elem>
        <elem>
          <copyFrom>HMC::tail</copyFrom>
